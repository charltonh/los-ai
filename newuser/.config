# ──────────────────────────────────────────────────────────────────────
#  .config — the AI side of your agenda: which model or agent runs where,
#  and what each of them is allowed to touch.
#
#  A section is called a *label*.  You pick one by name — `aicall <label>`
#  on the command line, or from the AI menu in the web app, which lists
#  every label that has an aiconfig= line.  This file is a starting point:
#  rename the labels, change the models, delete what you don't use.
#
#  Keys (only aiconfig is required):
#    aiconfig        the model or agent to run            ai/aiconfig.*
#    memory          directory for conversation memory    ai/memory
#    system_prompt   instructions always in effect        ai/prompt.*
#    default_prompt  extra instructions, after the system prompt
#    icon            /icons/<name>.svg, or an emoji such as 🤖
#    type=agent      the label runs an agent, not just a model
#    debug=1         verbose tracing in log/aicall.log
#
#  Filter lines decide which agendas a label may use.  They apply in
#  order, so the second line below wins for that entity:
#
#    + *                 every entity under your agenda directory
#    + money/invest      that sub-entity and everything below it
#    - private           ...except this one
#
#  A bare `default` line ends a section.
#
#  The paths below were filled in for your account when this file was
#  created.  Everything they point at lives in the ai/ directory next to
#  this file: the aiconfigs are the models, the prompts are the
#  instructions, and ai/memory/ is where notes are kept between runs.
# ──────────────────────────────────────────────────────────────────────


# ── Local model, no account and no API key ────────────────────────────
#  Works the moment Ollama is running on this machine (ollama serve) and
#  the model in ai/aiconfig.ollama has been pulled.
default:
aiconfig="/los/{user}/ai/aiconfig.ollama"
icon=/icons/ollama.svg
memory="/los/{user}/ai/memory"
system_prompt="/los/{user}/ai/prompt.default"
debug=0
+ *
default


# ── Cloud model through OpenRouter ────────────────────────────────────
#  Paste your key into ai/aiconfig.openrouter first, or delete this label.
openrouter:
aiconfig="/los/{user}/ai/aiconfig.openrouter"
icon=/icons/qwen.svg
memory="/los/{user}/ai/memory"
system_prompt="/los/{user}/ai/prompt.default"
debug=0
+ *
default


# ── External agents: OpenClaw and Hermes ──────────────────────────────
#  An agent thinks and uses tools on its own; LOS hands it this agenda and
#  a list of MCP tools.  Only define these once the agent is installed and
#  running — otherwise delete the label.

openclaw:
type=agent
aiconfig="/los/{user}/ai/aiconfig.openclaw"
icon=/icons/red-claw.svg
system_prompt="/los/{user}/ai/prompt.agent"
debug=0
+ *


hermes:
type=agent
aiconfig="/los/{user}/ai/aiconfig.hermes"
icon=/icons/hermes.svg
#agent=default              # profile to use (defaults to the aiconfig)
system_prompt="/los/{user}/ai/prompt.agent"
debug=0
+ *


# ── WhatsApp ──────────────────────────────────────────────────────────
#  'whatsapp' is the channel itself: a session and the phone numbers. It is
#  also a usable label — a prompt run against it can send messages with the
#  whatsapp_send tool, which is how scheduled notifications go out.
#  `los config` → Channels → WhatsApp fills in the same keys and starts
#  the browser session, so you rarely need to edit this section by hand.
#  Every incoming message goes to the label named in aicall_label —
#  whatsapp_incoming below — which is where the reply's model, memory and
#  prompt are set.

whatsapp:
type=whatsapp
aiconfig="/los/{user}/ai/aiconfig.ollama"
icon=/icons/ollama.svg
memory="/los/{user}/ai/memory"
system_prompt="/los/{user}/ai/prompt.whatsapp"
session_id="LOS-AI"
#origin_num=""                      # the number LOS sends from (digits only)
#owner_num=""                       # your own number, the default recipient
aicall_label="whatsapp_incoming"    # .config label for incoming messages
debug=0
+ *
#- private                          # exclude an entity like this
default


# ── Incoming WhatsApp messages ────────────────────────────────────────
whatsapp_incoming:
type=whatsapp
aiconfig="/los/{user}/ai/aiconfig.ollama"
icon=/icons/ollama.svg
memory="/los/{user}/ai/memory"
system_prompt="/los/{user}/ai/prompt.whatsapp"
debug=0
+ *
#- private                          # exclude an entity like this
default
