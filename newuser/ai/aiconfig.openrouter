{
  "llms": [
    {
      "api_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "PASTE-YOUR-OPENROUTER-KEY-HERE",
      "timeout": 300,
      "model": "qwen/qwen3-32b",
      "options": {
        "temperature": 0.7,
        "max_tokens": 1800,
        "n": 1,
        "stop": null
      }
    }
  ],

  "_comment": [
    "OpenRouter: one account, most models in the world.",
    "Create a key at openrouter.ai/keys and paste it into api_key above.",
    "'model' is any model id from openrouter.ai/models, e.g. qwen/qwen3-32b,",
    "anthropic/claude-sonnet-4 or openai/gpt-4o-mini.",
    "LOS tries each entry in 'llms' in order, so a cheap model can be listed",
    "as a fallback for a model that is busy or rate-limited."
  ]
}
